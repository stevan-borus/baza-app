{
  "name": "baza-app",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=./apps/mobile",
    "dev": "turbo run dev --filter=./apps/mobile",
    "lint": "turbo run lint --filter=./apps/mobile",
    "lint:all": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "oxlint": "1.89.0"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.28.0"
}
