APP_WEB_URL="http://localhost:8081"
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/baza_app?schema=public"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Baza Pilates <no-reply@yourdomain.com>"
# Sentry server-side error monitoring (baza-server project, baza-pilates org).
# OPTIONAL — unset = no server reporting (local/dev/CI). On Fly, set it as a
# secret: `fly secrets set SENTRY_DSN=... -a baza-pilates-staging` (and -prod).
SENTRY_DSN=""
EXPO_ACCESS_TOKEN=""
API_ADMIN_BOOTSTRAP_TOKEN="set-a-long-random-secret"
INVITE_TOKEN_TTL_HOURS=
RESET_TOKEN_TTL_MINUTES=
# Crons run as an external scheduled job (Fly Machines) that POSTs the
# /api/cron/* endpoints — NOT an in-process scheduler. Schedules live in
# lib/server/cron-jobs.ts; see docs/deployment-runbook.md → "Cron Scheduling".
BASE_URL="http://localhost:8081"
BETTER_AUTH_SECRET=""

EXPO_PUBLIC_API_URL=""

# Sentry (error monitoring). Two projects in the `baza-pilates` org (EU region):
#   - Client (this var): baza-mobile. A DSN is publishable — it ships in the app
#     bundle by design, so the real value is committed as the default in eas.json
#     and passed as a Dockerfile build ARG for the web export. Leave blank locally
#     to disable client reporting in dev.
#   - Server: baza-server → set the SENTRY_DSN Fly secret (see below), NOT here.
EXPO_PUBLIC_SENTRY_DSN=""

# Web "Get the app" banner store links (shown on accept-invite / reset-password
# when the app isn't installed). Android defaults from the package id; iOS needs
# the numeric App Store id once published, so leave blank until then (no banner).
EXPO_PUBLIC_IOS_STORE_URL=""
EXPO_PUBLIC_ANDROID_STORE_URL=""

# Universal Link / App Link host (bare hostname, NO scheme/path). Drives
# associatedDomains (iOS) + intentFilters (Android) in app.config.ts. Empty =
# links disabled. Dev: your `expo start --tunnel` host (e.g. baza-dev.ngrok.io);
# prod: the host of APP_WEB_URL. See public/.well-known/README.md.
EXPO_PUBLIC_LINK_HOST=""

# App-version nudge served by /api/app-version. OPTIONAL — when unset the
# endpoint reports the app's own version, so the feature is inert (nobody is
# nagged or blocked). Bump APP_LATEST_VERSION_* when a new native build ships to
# soft-nudge users to the store; raise APP_MIN_VERSION_* only to hard-block
# versions below it. Per-platform because iOS/Android releases land separately.
# Set these on the deployed server (Fly), not usually locally.
APP_MIN_VERSION_IOS=""
APP_LATEST_VERSION_IOS=""
APP_MIN_VERSION_ANDROID=""
APP_LATEST_VERSION_ANDROID=""

# DEV-ONLY preview override for the update popups. expo-updates is disabled in
# dev/Expo Go, so this is the only way to see the popups in a simulator. Honored
# only under __DEV__. Set to one of: ota | store-soft | store-required, then
# restart Metro. Leave blank in normal use (otherwise a popup shows every launch).
EXPO_PUBLIC_FORCE_UPDATE_PROMPT=""