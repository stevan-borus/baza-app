generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Enums-only Zod generation. Enums are the one place a generated schema has
// real sync value — a DB enum IS the API enum, so a new value must reach both
// automatically. Everything else (the ~2,700-file input/result/model variant
// trees) is deliberately NOT emitted: the API contract curates and refines
// each payload by hand (see the *FieldsSchema picks in packages/types), so
// generated model schemas were only ever used as a field-type lookup, not a
// contract — not worth 12MB of generated files. Config: prisma/zod-generator.config.json.
generator zod {
  provider = "prisma-zod-generator"
  output   = "../../../packages/types/src/generated/prisma-zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  CLIENT
}

enum InviteStatus {
  PENDING
  COMPLETED
  REVOKED
  EXPIRED
}

enum PaymentMethod {
  CASH
  CARD
  COMPANY
  MANUAL_ONLINE
}

enum BillingStatus {
  CONFIRMED
  // Pay-later assign: the package is active and bookable immediately, the
  // client pays in person later. Excluded from revenue until confirmed.
  PENDING
  // Revoked package's payment record, kept for the audit trail ("attended N,
  // never paid"). Never counted as revenue.
  VOIDED
}

enum SessionStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum NotificationType {
  BOOKING_CONFIRMED
  SESSION_UPDATED
  TRAINER_NOTE
  GENERAL
  BOOKING_CANCELED_ADMIN
  BOOKING_CANCELED_TRAINER
  CONSENT_REFUSED
  MINOR_PAPER_NEEDED
  BIRTHDAY_ADMIN_PROMPT
  BIRTHDAY_CLIENT_GIFT
  RESERVATION_UNBACKED_ATTENDANCE
  BULK_RESERVATION_CANCEL_ADMIN
  BULK_RESERVATION_CANCEL_TRAINER
  CAMPAIGN
  PACKAGE_ASSIGNED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum AppLocale {
  sr
  en
}

enum ConsentDocumentKey {
  tos
  privacy
  eula
  waiver_adult
  waiver_minor
  social_media
  health_intake
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  firstName    String
  lastName     String
  emailVerified Boolean             @default(false)
  image        String?
  phone        String?
  role         UserRole
  isActive     Boolean              @default(true)
  passwordHash String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  clientProfile ClientProfile?
  trainerProfile TrainerProfile?
  authSessions AuthSession[]
  authAccounts AuthAccount[]
  invitesSent  UserInvite[]         @relation("InviteCreatedBy")
  invitesReceived UserInvite[]      @relation("InvitedUser")
  passwordResets PasswordResetToken[]
  notificationPreference NotificationPreference?
  pushTokens   PushToken[]
  notifications NotificationLog[]
  campaigns               Campaign[]
  consentRecords          ConsentRecord[]
  consentRecordsVerified  ConsentRecord[]  @relation("GuardianVerifier")
  healthIntakesRecorded ClientHealthIntake[] @relation("HealthIntakeRecordedBy")
  trainerNotesAuthored TrainerNote[] @relation("TrainerNoteAuthor")
  trainerSessions       Session[]            @relation("SessionTrainer")
  trainerSchedules      RecurringSchedule[]  @relation("ScheduleTrainer")
  bookingsCreated       Booking[]            @relation("BookingCreatedBy")
  bookingsChargeWaived  Booking[]            @relation("BookingChargeWaivedBy")

  @@index([lastName])
}

model ClientProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  notes               String?
  dateOfBirth         DateTime? @db.Date
  activePackageStatus String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  waits               WaitlistEntry[]
  packageSessions     SessionConsumption[]
  packages            ClientPackage[]
  packagePauses       PackagePause[]
  trainerNotes        TrainerNote[]
  healthIntakes           ClientHealthIntake[]
  healthIntakeWithdrawals HealthIntakeWithdrawal[]
}

model TrainerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInvite {
  id             String      @id @default(uuid())
  email          String
  firstName      String
  lastName       String
  phone          String?
  dateOfBirth    DateTime?   @db.Date
  role           UserRole    @default(CLIENT)
  tokenHash      String      @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  invitedUserId  String?
  invitedUser    User?       @relation("InvitedUser", fields: [invitedUserId], references: [id])
  createdById    String?
  createdBy      User?       @relation("InviteCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([email, status])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ClassType {
  id           String   @id @default(uuid())
  name         String
  maxClients   Int
  durationMins Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions           Session[]
  packageTypeLinks   PackageTypeClassType[]
  clientPackageLinks ClientPackageClassType[]
}

model StudioRoom {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
}

model Session {
  id                   String              @id @default(uuid())
  classTypeId          String
  roomId               String?
  trainerUserId        String
  recurringScheduleId  String?
  startsAt             DateTime
  endsAt               DateTime
  capacity             Int
  // Optional admin-set binary marking that THIS occurrence is a hard one.
  // Default false = unmarked (the norm). Strictly per-occurrence — recurring
  // siblings are never touched. Advisory + display-only.
  isIntermediate       Boolean             @default(false)
  // Optional admin-set binary marking that THIS occurrence is a mixed group
  // (men and women train together). Same shape and rules as isIntermediate:
  // default false, strictly per-occurrence, advisory + display-only.
  isMixedGroup         Boolean             @default(false)
  // Hours before start at which THIS occurrence, with zero active bookings,
  // stops being bookable by clients. Per-occurrence like the markings above:
  // a one-off that needs a longer runway doesn't drag its siblings with it.
  // 0 disables the rule for this session.
  emptyBookingCutoffHours Int             @default(4)
  isActive             Boolean             @default(true)
  status               SessionStatus       @default(SCHEDULED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  classType            ClassType           @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  room                 StudioRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  trainer              User                @relation("SessionTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  recurringSchedule    RecurringSchedule?  @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  bookings             Booking[]
  waitlist             WaitlistEntry[]
  consumptions         SessionConsumption[]
  trainerNotes         TrainerNote[]

  @@index([startsAt])
  @@index([trainerUserId, startsAt])
  @@index([recurringScheduleId])
  // Room-conflict check on every session create/edit (and N× per recurring
  // create) filters by roomId + startsAt overlap.
  @@index([roomId, startsAt])
  // Consumption cron scans by session endsAt range.
  @@index([endsAt])
}

model RecurringSchedule {
  id            String    @id @default(uuid())
  classTypeId   String
  roomId        String?
  trainerUserId String
  weekdays      Int[]
  timeOfDayMins Int
  durationMins  Int
  capacity      Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  trainer       User      @relation("ScheduleTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  sessions      Session[]
}

model Booking {
  id              String        @id @default(uuid())
  sessionId       String
  clientProfileId String
  clientPackageId String?
  createdByUserId String?
  waivedByUserId  String?
  createdAt       DateTime      @default(now())
  canceledAt      DateTime?
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  waivedBy        User?         @relation("BookingChargeWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, clientProfileId])
  @@index([createdByUserId])
  @@index([waivedByUserId])
  // Hot paths: booking-hold count + trainer-linkage check + per-client
  // bookings list all filter by clientProfileId; the composite @@unique leads
  // with sessionId and can't serve them.
  @@index([clientProfileId])
  @@index([clientPackageId])
  @@index([createdAt])
}

model WaitlistEntry {
  id              String        @id @default(uuid())
  sessionId       String
  clientProfileId String
  position        Int
  createdAt       DateTime      @default(now())
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientProfileId])
  // booking-hold count filters waitlist by clientProfileId inside the booking tx.
  @@index([clientProfileId])
}

model PackageType {
  id                  String   @id @default(uuid())
  name                String
  sessionCount        Int
  validityDays        Int
  lateCancelHours     Int      @default(8)
  // Optional list price in RSD. Prefills the amount on paid assigns; the
  // admin can still override per payment, so it is advisory, not enforced.
  price               Int?
  isBirthdayGift      Boolean  @default(false)
  // A built-in gift row the app ensures on its own — hidden from catalog
  // management and protected from edit/delete. Admins never create gift SKUs.
  isSystem            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  classTypes          PackageTypeClassType[]
  clientPackages      ClientPackage[]
  billingRecords      BillingRecord[]
}

// Explicit join tables (ADR-0010): a PackageType covers a SET of ClassTypes
// (a "mix package" when >1), and a ClientPackage snapshots that set at
// activation. Explicit — not Prisma implicit m2m — so ClassType keeps
// onDelete: Restrict like every other ClassType reference in this schema.
model PackageTypeClassType {
  packageTypeId String
  classTypeId   String
  packageType   PackageType @relation(fields: [packageTypeId], references: [id], onDelete: Cascade)
  classType     ClassType   @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@id([packageTypeId, classTypeId])
  @@index([classTypeId])
}

model ClientPackageClassType {
  clientPackageId String
  classTypeId     String
  clientPackage   ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  classType       ClassType     @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@id([clientPackageId, classTypeId])
  @@index([classTypeId])
}

model ClientPackage {
  id                String              @id @default(uuid())
  clientProfileId   String
  packageTypeId     String
  lateCancelHours   Int
  startsAt          DateTime
  expiresAt         DateTime
  sessionsRemaining Int
  // Admin "+1 termin" grants snapshot here so a grant grows the TOTAL, not
  // past it: effective total = packageType.sessionCount + bonusSessions. Every
  // "x/y" site reads that sum, so an unused 12/12 → +1 → 13/13. Existing rows
  // default 0 (no grant yet), so the SKU's sessionCount stays the total.
  bonusSessions     Int                 @default(0)
  // Keep-the-trace revoke: a revoked package stops granting booking rights,
  // but the row (and its past bookings/consumption) stays for the record.
  revokedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  clientProfile     ClientProfile       @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  packageType       PackageType         @relation(fields: [packageTypeId], references: [id], onDelete: Restrict)
  classTypes        ClientPackageClassType[]
  bookings          Booking[]
  billingRecord     BillingRecord?

  @@index([clientProfileId])
}

model PackagePause {
  id              String        @id @default(uuid())
  clientProfileId String
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdAt       DateTime      @default(now())
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  // Pauses are read in every eligibility check (availability, booking, cancel,
  // waitlist promotion), always filtered by clientProfileId.
  @@index([clientProfileId])
}

model SessionConsumption {
  id                String        @id @default(uuid())
  clientProfileId   String
  sessionId         String
  consumedAt        DateTime      @default(now())
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  session           Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([clientProfileId, sessionId])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  pushEnabled      Boolean  @default(true)
  inAppEnabled     Boolean  @default(true)
  campaignsEnabled    Boolean @default(true)   // marketing opt-out (Promocije / novi programi)
  bookingEmailsEnabled Boolean @default(true)  // courtesy opt-out for booking-change emails
  preferredLocale  AppLocale?  // null => default "sr" for notifications
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  id            String   @id @default(uuid())
  userId        String
  deviceId      String
  expoPushToken String   @unique
  isActive      Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
}

model NotificationLog {
  id          String           @id @default(uuid())
  userId      String
  notificationKey String?      @unique
  type        NotificationType @default(GENERAL)
  title       String
  body        String
  payload     Json?
  pushSent    Boolean          @default(false)
  pushStatus  String?
  readAt      DateTime?
  campaignId  String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([campaignId])
}

model Campaign {
  id              String         @id @default(uuid())
  createdByUserId String
  title           String
  body            String
  audienceSpec    Json
  recipientCount  Int            @default(0)
  status          CampaignStatus @default(DRAFT)
  scheduledFor    DateTime?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  notifications   NotificationLog[]

  @@index([status, scheduledFor])
}

model TrainerNote {
  id              String         @id @default(uuid())
  // Optional: a note may be attached to a specific session ("observed in
  // 10:00 Reformer") or be a free-form client note ("recurring lower-back
  // complaint"). When set, the server still enforces the trainer-owns-
  // session + client-is-booked rules — see POST handler.
  sessionId       String?
  clientProfileId String
  trainerUserId   String
  note            String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  session         Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientProfile   ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  trainer         User           @relation("TrainerNoteAuthor", fields: [trainerUserId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([clientProfileId, createdAt])
  // Trainer's default notes feed lists by author, newest first.
  @@index([trainerUserId, createdAt])
}

model BillingRecord {
  id              String         @id @default(uuid())
  clientUserId    String
  amount          Int
  method          PaymentMethod
  status          BillingStatus  @default(CONFIRMED)
  notes           String?
  packageTypeId   String?
  packageType     PackageType?   @relation(fields: [packageTypeId], references: [id], onDelete: SetNull)
  clientPackageId String?        @unique
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([packageTypeId])
  // Per-client billing pairing (client-packages, /clients/me/packages) filters
  // by clientUserId; the Naplata list + /billing/summary + revenue report all
  // filter createdAt range ± status.
  @@index([clientUserId])
  @@index([status, createdAt])
}

model ConsentRecord {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentKey          ConsentDocumentKey
  version              Int
  locale               AppLocale
  accepted             Boolean
  acceptedAt           DateTime            @default(now())
  ipAddress            String?
  userAgent            String?
  appVersion           String?
  guardianName         String?
  guardianRelation     String?
  guardianVerifiedAt   DateTime?
  guardianVerifiedById String?
  guardianVerifiedBy   User?               @relation("GuardianVerifier", fields: [guardianVerifiedById], references: [id])

  @@index([userId, documentKey, version])
  @@index([userId, acceptedAt])
}

model ClientHealthIntake {
  id                        String        @id @default(uuid())
  clientProfileId           String
  clientProfile             ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  // Health history (Q1): multi-select of named conditions + free-text catch-all.
  // Codes are stable identifiers; see HEALTH_CONDITION_CODES in @baza/types.
  conditions                String[]
  conditionsOther           String?
  // Q2: medical treatment / medication.
  underMedicalTreatment     Boolean
  medicalTreatmentDetails   String?
  // Q3: prior Pilates experience (multi-select including "none").
  pilatesExperience         String[]
  pilatesExperienceDuration String?
  // Q4: daily activity level (single-select enum code).
  activityLevel             String
  // Q5: weekly exercise frequency (single-select bucket).
  exerciseFrequency         String
  // Q6: training goals (multi-select + free-text other).
  goals                     String[]
  goalsOther                String?
  // Q7: body-awareness — movements that trigger discomfort.
  discomfortDuring          String[]
  // Q8: free-text catch-all.
  additionalNotes           String?
  // Audit metadata + guardian (kept for minor-waiver flow).
  recordedAt                DateTime      @default(now())
  recordedByUserId          String?
  recordedBy                User?         @relation("HealthIntakeRecordedBy", fields: [recordedByUserId], references: [id])
  guardianName              String?
  guardianRelation          String?

  @@index([clientProfileId, recordedAt])
}

model HealthIntakeWithdrawal {
  id              String        @id @default(uuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  withdrawnAt     DateTime      @default(now())

  @@index([clientProfileId, withdrawnAt])
}
