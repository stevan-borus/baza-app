{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "(xcrun simctl launch booted com.steva.borus.baza-pilates || true) && expo start --dev-client --port 8090",
    "start": "expo start --dev-client --port 8090",
    "dev:go": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "web": "expo start --web --port 8090",
    "legal:bundle": "tsx scripts/generate-legal-bundle.ts",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check-types": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "cron:run": "tsx scripts/run-cron.ts",
    "cron:reminders": "tsx scripts/run-cron.ts reminders --mode immediate --window-minutes 1440",
    "cron:expiry": "tsx scripts/run-cron.ts package-expiry --mode immediate --window-days 30",
    "cron:sessions": "tsx scripts/run-cron.ts session-consumption --mode immediate --lookback-hours 720",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:db:unpatch": "tsx scripts/dev/unpatch-dev-db.ts",
    "test:db:bootstrap": "tsx scripts/test/bootstrap-test-db.ts",
    "test:db:prepare": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public prisma migrate reset --force",
    "dev:db:reseed": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public prisma migrate reset --force && DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public TEST_ANCHOR_TIME='' tsx scripts/test/seed-e2e.ts",
    "test:db:patch": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/patch-test-db.ts",
    "test:db:seed-e2e": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/seed-e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:prepare": "pnpm test:db:bootstrap && pnpm test:db:prepare && pnpm test:db:patch && pnpm test:db:seed-e2e",
    "test:e2e:maestro:build": "scripts/test/build-e2e.sh",
    "test:e2e:maestro": "scripts/test/run-e2e.sh"
  },
  "dependencies": {
    "@baza/i18n": "workspace:*",
    "@baza/types": "workspace:*",
    "@better-auth/expo": "^1.4.18",
    "@expo-google-fonts/albert-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@legendapp/list": "^2.0.19",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@prisma/client-runtime-utils": "^7.4.0",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-navigation/native": "^7.1.8",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.18",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-picker": "^55.0.19",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "^17.0.8",
    "expo-network": "^8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-server": "^1.0.5",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.11",
    "moti": "^0.30.0",
    "pg": "^8.18.0",
    "react": "19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "~4.1.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "resend": "^6.9.2",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "uniwind": "^1.6.3",
    "victory-native": "^41.20.2",
    "zod": "^4.3.6"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25",
    "@types/pg": "^8.16.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/expect": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "^55.0.21",
    "prisma": "^7.4.0",
    "prisma-zod-generator": "^2.1.4",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
