{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "(xcrun simctl launch booted com.bazapilates.app || true) && expo start --dev-client --port 8090",
    "start": "expo start --dev-client --port 8090",
    "dev:go": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "web": "expo start --web --port 8090",
    "legal:bundle": "tsx scripts/generate-legal-bundle.ts",
    "prisma:generate": "DATABASE_URL=\"postgresql://build:build@localhost:5432/build\" prisma generate",
    "postinstall": "pnpm prisma:generate",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check-types": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "build:server": "expo export -p web",
    "start:server": "node server/index.js",
    "cron:run": "tsx scripts/run-cron.ts",
    "cron:reminders": "tsx scripts/run-cron.ts reminders --mode immediate --window-minutes 1440",
    "cron:expiry": "tsx scripts/run-cron.ts package-expiry --mode immediate --window-days 30",
    "cron:sessions": "tsx scripts/run-cron.ts session-consumption --mode immediate --lookback-hours 720",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:db:unpatch": "tsx scripts/dev/unpatch-dev-db.ts",
    "test:db:bootstrap": "tsx scripts/test/bootstrap-test-db.ts",
    "test:db:prepare": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public prisma migrate reset --force",
    "dev:db:reseed": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public prisma migrate reset --force && DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public TEST_ANCHOR_TIME='' tsx scripts/test/seed-e2e.ts",
    "test:db:patch": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/patch-test-db.ts",
    "test:db:seed-e2e": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/seed-e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:prepare": "pnpm test:db:bootstrap && pnpm test:db:prepare && pnpm test:db:patch && pnpm test:db:seed-e2e",
    "test:db:prepare:ci": "prisma migrate reset --force",
    "test:db:patch:ci": "FORCE_PATCH=1 tsx scripts/test/patch-test-db.ts",
    "test:db:seed-e2e:ci": "tsx scripts/test/seed-e2e.ts",
    "test:e2e:prepare:ci": "pnpm test:db:prepare:ci && pnpm test:db:patch:ci && pnpm test:db:seed-e2e:ci",
    "test:e2e:maestro:build": "scripts/test/build-e2e.sh",
    "test:e2e:maestro": "scripts/test/run-e2e.sh"
  },
  "dependencies": {
    "@baza/i18n": "workspace:*",
    "@baza/types": "workspace:*",
    "@better-auth/expo": "^1.6.20",
    "@expo-google-fonts/albert-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/list": "^3.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@sentry/node": "^10.63.0",
    "@sentry/react-native": "~7.11.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.20",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "expo": "~56.0.12",
    "expo-application": "~56.0.3",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.7",
    "expo-haptics": "^56.0.3",
    "expo-image": "^56.0.11",
    "expo-image-picker": "^56.0.18",
    "expo-linear-gradient": "^56.0.4",
    "expo-linking": "~56.0.14",
    "expo-localization": "^56.0.6",
    "expo-network": "^56.0.5",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-secure-store": "^56.0.4",
    "expo-server": "^56.0.5",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "express": "^5.2.1",
    "i18next": "^25.8.11",
    "lucide-react-native": "^1.21.0",
    "moti": "^0.30.0",
    "pg": "^8.22.0",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "resend": "^6.14.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "uniwind": "^1.9.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sentry/cli": "2.58.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/expect": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "^56.0.15",
    "prisma": "^7.8.0",
    "prisma-zod-generator": "^2.1.4",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
