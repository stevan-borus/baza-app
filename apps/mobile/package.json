{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "(xcrun simctl launch booted com.bazapilates.app || true) && expo start --dev-client --port 8090",
    "start": "expo start --dev-client --port 8090",
    "dev:go": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "web": "expo start --web --port 8090",
    "legal:bundle": "tsx scripts/generate-legal-bundle.ts",
    "gen:api-registry": "tsx scripts/gen-api-registry.ts",
    "prisma:generate": "DATABASE_URL=\"postgresql://build:build@localhost:5432/build\" prisma generate",
    "postinstall": "pnpm prisma:generate",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check-types": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "ota": "node scripts/ota-update.mjs",
    "ota:staging": "node scripts/ota-update.mjs preview",
    "ota:prod": "node scripts/ota-update.mjs production",
    "db:status": "prisma migrate status",
    "build:server": "expo export -p web",
    "start:server": "node server/index.js",
    "cron:run": "tsx scripts/run-cron.ts",
    "cron:reminders": "tsx scripts/run-cron.ts reminders --mode immediate --window-minutes 1440",
    "cron:expiry": "tsx scripts/run-cron.ts package-expiry --mode immediate --window-days 30",
    "cron:sessions": "tsx scripts/run-cron.ts session-consumption --mode immediate --lookback-hours 720",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "dev:db:unpatch": "tsx scripts/dev/unpatch-dev-db.ts",
    "test:db:bootstrap": "tsx scripts/test/bootstrap-test-db.ts",
    "test:db:prepare": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public prisma migrate reset --force",
    "dev:db:reseed": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public prisma migrate reset --force && DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app?schema=public TEST_ANCHOR_TIME='' tsx scripts/test/seed-e2e.ts",
    "test:db:patch": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/patch-test-db.ts",
    "test:db:seed-e2e": "DATABASE_URL=postgresql://postgres:postgres@localhost:5434/baza_app_test?schema=public tsx scripts/test/seed-e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:prepare": "pnpm test:db:bootstrap && pnpm test:db:prepare && pnpm test:db:patch && pnpm test:db:seed-e2e",
    "test:db:prepare:ci": "prisma migrate reset --force",
    "test:db:patch:ci": "FORCE_PATCH=1 tsx scripts/test/patch-test-db.ts",
    "test:db:seed-e2e:ci": "tsx scripts/test/seed-e2e.ts",
    "test:e2e:prepare:ci": "pnpm test:db:prepare:ci && pnpm test:db:patch:ci && pnpm test:db:seed-e2e:ci",
    "test:e2e:maestro:build": "scripts/test/build-e2e.sh",
    "test:e2e:maestro": "scripts/test/run-e2e.sh",
    "reset-local-passwords": "tsx scripts/reset-local-passwords.ts",
    "native:prebuild:ios": "expo prebuild --platform ios",
    "native:prebuild:android": "expo prebuild --platform android",
    "expo:check": "expo install --check",
    "expo:config": "expo config"
  },
  "dependencies": {
    "@baza/i18n": "workspace:*",
    "@baza/types": "workspace:*",
    "@better-auth/expo": "^1.7.12",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo-google-fonts/albert-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/list": "^3.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.2.2",
    "@sentry/node": "^11.8.0",
    "@sentry/react-native": "~8.32.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-server": "~58.0.5",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "express": "^5.3.0",
    "i18next": "^26.5.6",
    "lucide-react-native": "^1.61.0",
    "moti": "^0.30.0",
    "pg": "^8.23.1",
    "punycode": "^2.3.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.3",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "resend": "^6.34.1",
    "tailwindcss": "4.3.3",
    "tslib": "^2.8.1",
    "uniwind": "1.13.0",
    "zod": "^4.6.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "3.8.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.19",
    "dotenv": "18.0.9",
    "prisma": "^7.10.1",
    "prisma-zod-generator": "^3.3.1",
    "react-test-renderer": "19.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
