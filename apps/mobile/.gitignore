# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase Android config. Holds the FCM sender/app IDs for com.bazapilates.app,
# so it stays out of git. EAS builds get it from the file-type project secret
# GOOGLE_SERVICES_JSON; locally you need your own copy from the Firebase console.
# See AGENTS.md -> Deploying -> Android push (FCM).
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Playwright output
/test-results
/playwright-report
/playwright/.cache
# E2E-only invite token the server drops for the accept-invite chain
/.playwright-tmp

# Maestro (E2E) — captured reset token from password-reset flow
.maestro/.tmp/

# E2E build artifacts
.env.test.local
