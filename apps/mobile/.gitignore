# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Playwright output
/test-results
/playwright-report
/playwright/.cache
# E2E-only invite token the server drops for the accept-invite chain
/.playwright-tmp

# Maestro (E2E) — captured reset token from password-reset flow
.maestro/.tmp/

# E2E build artifacts
.env.test.local
