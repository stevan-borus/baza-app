{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_UNSTABLE_DEPLOY_SERVER": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_UNSTABLE_DEPLOY_SERVER": "1"
      }
    }
  }
}
